NODE_ENV=development
PORT=4000

# This project uses MongoDB Atlas, the hosted MongoDB service. Create a free
# cluster at https://cloud.mongodb.com, then Connect → Drivers → copy the string.
# Put your own database user's password in it, and end it with /taskflow so the
# data lands in a database of that name.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/taskflow?retryWrites=true&w=majority

# A local MongoDB works exactly as well — use this line instead if you have one:
# MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Generate your own with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# How many proxies stand in front of this server.
#
# Express reads the caller's address off the socket. Behind a load balancer
# that socket belongs to the balancer, so every request looks like it came from
# the same place — and the login limit of five attempts per address per fifteen
# minutes becomes five attempts for EVERYBODY.
#
# 0 on a laptop, which is the default: with nothing in front, a forwarded-for
# header is written by whoever sent it and must not be believed.
# 1 behind one proxy, 2 on Render behind a Vercel rewrite. See render.yaml.
# TRUST_PROXY_HOPS=0

# How many people fit in the workspace. The Team footer reads it ("4 members ·
# 3 seats remaining") and an invite is refused when there are none left, so it
# is a real limit rather than a display value.
# SEAT_LIMIT=7

# Rate limiting. All three are optional — leave them out and the defaults below
# are used. They are settings rather than constants so a limit can be lowered
# for one run to watch it fire, without editing the source and risking a
# 2-attempt login limit being left behind.
#
# RATE_LIMIT_WINDOW_MINUTES=15
#
# Login and register. Strict, because this is where password guessing happens.
# RATE_LIMIT_AUTH_MAX=5
#
# Everything else under /api. Loose — this is for abuse, not guessing, and a
# limit a real person can reach is a bug.
# RATE_LIMIT_API_MAX=300

# Where the frontend lives. Used to build the link inside a password reset
# email, so it must be the address a person can actually open in a browser.
# APP_URL=http://localhost:5173

# Sending email — needed only for password reset.
#
# ALL OPTIONAL. Leave them out and the app still runs: the reset link is
# printed to the server console instead, with a warning. Fill them in and real
# email is sent.
#
# Gmail: turn on 2-step verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use that 16-character code as
# SMTP_PASS — your normal password will not work.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_SECURE=false          # true only for port 465
# SMTP_FROM=TaskFlow <you@gmail.com>
